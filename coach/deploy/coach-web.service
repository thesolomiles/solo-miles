[Unit]
Description=Coach web app (FastAPI)
After=network.target

[Service]
Type=simple
User=coach
Group=coach
WorkingDirectory=/opt/solo-miles/coach
ExecStart=/opt/solo-miles/coach/.venv/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8008
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
